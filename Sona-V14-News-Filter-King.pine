 // @version=5
indicator("Sona V14 News Filter King - L6SJ", overlay=true)
useNewsFilter = input.bool(true, "🔴 News Filter ON/OFF")
newsStartHour = input.int(13, "News Start Hour GMT")
newsEndHour = input.int(15, "News End Hour GMT")
isNewsTime = hour >= newsStartHour and hour <= newsEndHour
isSafeToTrade = not useNewsFilter or not isNewsTime
len1 = input.int(34, "L1 Length")
len2 = input.int(55, "L2 Length")
len3 = input.int(89, "L3 Length")
len4 = input.int(144, "L4 Length")
len5 = input.int(233, "L5 Length")
len6 = input.int(377, "L6 Length")
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)
ema3 = ta.ema(close, len3)
ema4 = ta.ema(close, len4)
ema5 = ta.ema(close, len5)
ema6 = ta.ema(close, len6)
bullConfluence = ema1 > ema2 and ema2 > ema3 and ema3 > ema4
bearConfluence = ema1 < ema2 and ema2 < ema3 and ema3 < ema4
buySignal = bullConfluence and ta.crossover(ema1, ema2) and isSafeToTrade
sellSignal = bearConfluence and ta.crossunder(ema1, ema2) and isSafeToTrade
plot(ema1, "L1", color=color.yellow)
plot(ema6, "L6", color=color.red, linewidth=3)
plotshape(buySignal, style=shape.labelup, location=location.belowbar, color=color.green, text="BUY KING", size=size.small)
plotshape(sellSignal, style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL KING", size=size.small)
bgcolor(isNewsTime and useNewsFilter ? color.new(color.red, 90) : na, title="News Time")
alertcondition(buySignal, "Sona V14 BUY", "Sona BUY + Safe")
alertcondition(sellSignal, "Sona V14 SELL", "Sona SELL + Safe")
